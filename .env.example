# Postgres. En Vercel se rellena sola al conectar Neon o Supabase.
# Usa siempre la cadena "pooled" del proveedor.
DATABASE_URL=postgresql://usuario:contraseña@host/basededatos

# Clave de OpenRouter de la instalación. La pagan sus tokens, así que
# nunca se envía al navegador: solo la usa /api/chat.
OPENROUTER_API_KEY=sk-or-...

# Correo que recibe el rol de administrador al registrarse.
# El primer usuario que se registre también será administrador.
ADMIN_EMAIL=rmickel@gmail.com

# Mensajes al mes que recibe cada cuenta nueva.
DEFAULT_MONTHLY_LIMIT=50

# Pon "false" para cerrar el registro y dar de alta solo tú.
REGISTRATION_OPEN=true

# Tope de tokens por respuesta.
OPENROUTER_MAX_TOKENS=2000

# URL pública, para la cabecera que OpenRouter usa en sus estadísticas.
PUBLIC_URL=https://llm.desdechina.es

# Solo para pruebas o si pones un proxy propio delante de OpenRouter.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
